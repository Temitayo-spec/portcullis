[
  { "name": "unreachable at launch runs", "rule": "R22",
    "now": "2026-10-13T12:00:00Z",
    "reading": "unreachable",
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "a broken body at launch runs", "rule": "R22",
    "now": "2026-10-13T12:00:00Z",
    "reading": "invalid",
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "a failed recheck keeps the pause", "rule": "R22",
    "now": "2026-10-13T12:00:00Z",
    "current": { "kind": "maintenance", "reason": "outage", "until": null },
    "reading": "unreachable",
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "maintenance", "reason": "outage" } },

  { "name": "a broken body keeps the pause", "rule": "R22",
    "now": "2026-10-13T12:00:00Z",
    "current": { "kind": "maintenance", "reason": null, "until": null },
    "reading": "invalid",
    "device": { "store": "appstore", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "maintenance" } },

  { "name": "a failed recheck keeps the update screen", "rule": "R22",
    "now": "2026-10-13T12:00:00Z",
    "current": { "kind": "update", "store": "play", "below": "version", "minimum": "2.5.0", "current": "2.4.0" },
    "reading": "unreachable",
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "minimum": "2.5.0" } },

  { "name": "a failed read keeps the last switches", "rule": "R22",
    "now": "2026-10-13T12:00:00Z", "switchIds": ["rewards"],
    "current": { "kind": "run", "switches": { "rewards": false } },
    "reading": "unreachable",
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run", "switches": { "rewards": false } } },

  { "name": "an empty gate lifts a pause", "rule": "R23",
    "now": "2026-10-13T12:00:00Z",
    "current": { "kind": "maintenance", "reason": null, "until": null },
    "gate": {},
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "a new reason replaces the old one", "rule": "R23",
    "now": "2026-10-13T12:00:00Z",
    "current": { "kind": "maintenance", "reason": "upgrade", "until": null },
    "gate": { "maintenance": { "active": true, "reason": "outage" } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "maintenance", "reason": "outage" } },

  { "name": "an answer clears switches it no longer sets", "rule": "R23",
    "now": "2026-10-13T12:00:00Z", "switchIds": ["rewards"],
    "current": { "kind": "run", "switches": { "rewards": false } },
    "gate": {},
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run", "switches": {} } },

  { "name": "a JSON array is an answer that means run", "rule": "R21",
    "now": "2026-10-13T12:00:00Z",
    "current": { "kind": "maintenance", "reason": null, "until": null },
    "gate": [],
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } }
]
