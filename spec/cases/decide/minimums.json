[
  { "name": "below the minimum version asks for an update", "rule": "R16",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.1" } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "store": "play", "below": "version", "minimum": "2.4.1", "current": "2.4.0" } },

  { "name": "1.0.10 is newer than 1.0.9", "rule": "R16",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "1.0.10" } } },
    "device": { "store": "play", "version": "1.0.9", "build": "40" },
    "expect": { "kind": "update", "below": "version", "minimum": "1.0.10", "current": "1.0.9" } },

  { "name": "the same version runs", "rule": "R16",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "a newer version runs", "rule": "R16",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": "2.5.0", "build": "130" },
    "expect": { "kind": "run" } },

  { "name": "1.2 equals 1.2.0", "rule": "R16",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "1.2.0" } } },
    "device": { "store": "play", "version": "1.2", "build": "20" },
    "expect": { "kind": "run" } },

  { "name": "a four-part minimum is compared in full", "rule": "R15",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0.1" } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "below": "version", "minimum": "2.4.0.1", "current": "2.4.0" } },

  { "name": "a beta tail on the device is ignored", "rule": "R15",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "appstore": { "minVersion": "2.4.0" } } },
    "device": { "store": "appstore", "version": "2.3.9-beta.2", "build": "88" },
    "expect": { "kind": "update", "store": "appstore", "below": "version", "minimum": "2.4.0", "current": "2.3.9" } },

  { "name": "a leading v on the device is ignored", "rule": "R15",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": "v2.3.0", "build": "110" },
    "expect": { "kind": "update", "below": "version", "current": "2.3.0" } },

  { "name": "a device version with words in it cannot be read", "rule": "R18",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": "2.3.1 (beta)", "build": "115" },
    "expect": { "kind": "run" } },

  { "name": "a five-part device version cannot be read", "rule": "R18",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": "2.3.1.0.7", "build": "115" },
    "expect": { "kind": "run" } },

  { "name": "a gate version that cannot be read asks nobody", "rule": "R18",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "latest" } } },
    "device": { "store": "play", "version": "1.0.0", "build": "1" },
    "expect": { "kind": "run" } },

  { "name": "an unknown device version asks nobody", "rule": "R18",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": null, "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "another store's minimum does not apply", "rule": "R14",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "appstore": { "minVersion": "9.0.0" } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "Galaxy Store installs follow their own minimum", "rule": "R14",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "com.sec.android.app.samsungapps": { "minVersion": "2.5.0" } } },
    "device": { "store": "com.sec.android.app.samsungapps", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "store": "com.sec.android.app.samsungapps", "below": "version" } },

  { "name": "a Play minimum does not reach Huawei installs", "rule": "R14",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "9.0.0" } } },
    "device": { "store": "com.huawei.appmarket", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "an install with no store is never asked to update", "rule": "R14",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "9.0.0" }, "appstore": { "minVersion": "9.0.0" } } },
    "device": { "store": null, "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "below the minimum build asks for an update", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minBuild": 121 } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "store": "play", "below": "build", "minimum": 121, "current": 120 } },

  { "name": "the same build runs", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minBuild": 120 } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } },

  { "name": "version is checked before build", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.5.0", "minBuild": 200 } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "below": "version" } },

  { "name": "the build check still runs when the version is fine", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0", "minBuild": 125 } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "below": "build", "minimum": 125, "current": 120 } },

  { "name": "a dotted iOS build cannot be read", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "appstore": { "minBuild": 50 } } },
    "device": { "store": "appstore", "version": "2.4.0", "build": "1.0.3" },
    "expect": { "kind": "run" } },

  { "name": "a build over the ceiling cannot be read", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minBuild": 50 } } },
    "device": { "store": "play", "version": "2.4.0", "build": "2100000001" },
    "expect": { "kind": "run" } },

  { "name": "an unknown device build asks nobody", "rule": "R18",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minBuild": 500 } } },
    "device": { "store": "play", "version": "2.4.0", "build": null },
    "expect": { "kind": "run" } },

  { "name": "a device version with spaces around it cannot be read", "rule": "R15",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": " 2.3.0 ", "build": "110" },
    "expect": { "kind": "run" } },

  { "name": "a capital V cannot be read", "rule": "R15",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.4.0" } } },
    "device": { "store": "play", "version": "V2.3.0", "build": "110" },
    "expect": { "kind": "run" } },

  { "name": "the gate's minVersion is read like the device's", "rule": "R15",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minVersion": "2.5.0-rc1" } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "update", "below": "version", "minimum": "2.5.0", "current": "2.4.0" } },

  { "name": "a gate minBuild written as a string asks nobody", "rule": "R17",
    "now": "2026-10-13T12:00:00Z",
    "gate": { "stores": { "play": { "minBuild": "200" } } },
    "device": { "store": "play", "version": "2.4.0", "build": "120" },
    "expect": { "kind": "run" } }
]
